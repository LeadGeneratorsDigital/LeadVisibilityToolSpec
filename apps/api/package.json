{
  "name": "@lvt/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "create-user": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "seed-history": "tsx --env-file-if-exists=.env scripts/seed-history.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.3.0",
    "@lvt/shared": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "fastify": "^5.1.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
