PORT=8787
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# mock = generated DataForSEO-shaped responses; live = real API (needs login + password);
# sandbox = sandbox.dataforseo.com with the same login, free, dummy results. Sandbox and mock
# rankings are still written to the database, so use them on a test project, not the client's.
DATAFORSEO_MODE=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
MOCK_ERROR_RATE=0.05
MOCK_LATENCY_MS=800
PULL_CONCURRENCY=10
# Per-request timeout for the live API; a timed-out phrase is stored as NULL like any other error.
DATAFORSEO_TIMEOUT_MS=120000

# Leave empty to use the demo brief merger (appends notes) instead of Claude; in production
# without ALLOW_MOCKS an empty key turns "Update brief" off (it answers 503) instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# `pnpm start` runs with NODE_ENV=production, which refuses mock DataForSEO and turns brief
# merging off without ANTHROPIC_API_KEY. Set to true only for a demo deploy on mock data.
ALLOW_MOCKS=false
